{
  "name": "moddex-js",
  "version": "1.0.0",
  "description": "A framework-agnostic fully typed JavaScript client for the ModDex API",
  "homepage": "https://moddex-js.creeperkatze.dev",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "website:api": "typedoc --options typedoc.json",
    "website:dev": "concurrently -n typedoc,vitepress -c yellow,cyan \"typedoc --options typedoc.json --watch\" \"vitepress dev website\"",
    "website:build": "pnpm website:api && vitepress build website",
    "website:preview": "vitepress preview website",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:live": "vitest run tests/live",
    "test:coverage": "vitest run --coverage",
    "release:patch": "pnpm version patch && git push && git push --tags",
    "release:minor": "pnpm version minor && git push && git push --tags",
    "release:major": "pnpm version major && git push && git push --tags"
  },
  "keywords": [
    "moddex",
    "minecraft",
    "mods",
    "modpacks",
    "reviews",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/creeperkatze/moddex-js"
  },
  "bugs": {
    "url": "https://github.com/creeperkatze/moddex-js/issues"
  },
  "author": "Creeperkatze",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/vue": "^1.48.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  }
}
